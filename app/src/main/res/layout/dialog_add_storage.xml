<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/et_storage_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/storage_name"
        android:inputType="textCapWords" />

    <EditText
        android:id="@+id/et_storage_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/storage_description"
        android:inputType="textCapSentences" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/select_icon"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/rg_icon_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rb_ref"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/icon_fridge"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb_freezer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/icon_freezer" />

        <RadioButton
            android:id="@+id/rb_crisper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/icon_crisper" />
    </RadioGroup>

</LinearLayout>
